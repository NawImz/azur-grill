---
import { lien } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import restaurant from '../data/restaurant.json';
---

<Layout titre={`Page introuvable — ${restaurant.nom}`} description="Cette page n'existe pas.">
  <Header />
  <main id="contenu" class="flex min-h-[70svh] items-center bg-nazar">
    <div class="mx-auto max-w-2xl px-5 py-24 text-center md:px-8">
      <p class="font-display text-5xl font-700 text-ciel">404</p>
      <h1 class="mt-4 font-display text-3xl font-700 text-creme">Cette page n'existe pas.</h1>
      <p class="mt-4 text-creme/80">Le grill, lui, est toujours là.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={lien("")} class="inline-flex min-h-12 items-center rounded-full bg-braise px-7 font-bold text-encre">
          Retour à l'accueil
        </a>
        <a href={restaurant.telephoneLien} class="inline-flex min-h-12 items-center rounded-full border border-creme/40 px-7 font-semibold text-creme">
          {restaurant.telephone}
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
