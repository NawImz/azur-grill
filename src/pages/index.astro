---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import Reviews from '../components/Reviews.astro';
import Lieu from '../components/Lieu.astro';
import PracticalInfo from '../components/PracticalInfo.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import SliceReveal from '../components/SliceReveal.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
---

<Layout>
  <Header />
  <main id="contenu" class="pb-20 md:pb-0">
    <Hero />
    <Menu />
    <Reviews />
    <Lieu />
    <PracticalInfo />
  </main>
  <Footer />
  <StickyMobileBar />
  <SmoothScroll />
  <SliceReveal />
</Layout>
