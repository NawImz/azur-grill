---
/**
 * Nazar boncugu — structure et couleurs relevees sur le logo reel :
 * anneau marine #16098F, cerne blanc, iris #74C0EC, pupille noire.
 * `tone="mono"` pour les emplois ou une seule couleur est disponible.
 */
interface Props {
  class?: string;
  tone?: 'couleur' | 'mono';
}

const { class: className = 'w-6 h-6', tone = 'couleur' } = Astro.props;
---

<svg viewBox="0 0 64 64" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {tone === 'couleur' ? (
    <>
      <circle cx="32" cy="32" r="31" fill="var(--color-nazar)" />
      <circle cx="32" cy="32" r="23" fill="#FCFEFE" />
      <circle cx="32" cy="32" r="14" fill="var(--color-ciel)" />
      <circle cx="32" cy="32" r="6" fill="#0B0A14" />
    </>
  ) : (
    <>
      <circle cx="32" cy="32" r="31" fill="none" stroke="currentColor" stroke-width="2.5" />
      <circle cx="32" cy="32" r="21" fill="currentColor" opacity="0.18" />
      <circle cx="32" cy="32" r="12" fill="currentColor" opacity="0.55" />
      <circle cx="32" cy="32" r="5" fill="currentColor" />
    </>
  )}
</svg>
