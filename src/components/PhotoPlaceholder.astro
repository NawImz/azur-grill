---
import NazarMark from './NazarMark.astro';

interface Props {
  label: string;
  class?: string;
  tone?: 'dark' | 'warm' | 'light';
}

const { label, class: className = 'relative', tone = 'warm' } = Astro.props;

const tones = {
  dark: 'bg-gradient-to-br from-nazar via-nazar to-[#0f1a30] text-creme/90',
  warm: 'bg-gradient-to-br from-brique via-[#9c4b29] to-nazar text-creme/90',
  light: 'bg-gradient-to-br from-ciel/25 via-creme to-moutarde/20 text-nazar/70',
};
---

<div class={className}>
  <div class:list={['absolute inset-0 overflow-hidden flex items-end', tones[tone]]}>
    <NazarMark class:list={[
      'absolute -right-6 -top-6 w-40 h-40 opacity-[0.14]',
      tone === 'light' ? 'text-nazar' : 'text-creme',
    ]} />
    <p class="relative z-10 text-xs font-semibold uppercase tracking-[0.14em] px-4 py-3 opacity-80">
      Photo à venir — {label}
    </p>
  </div>
</div>
