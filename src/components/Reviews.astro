---
import restaurant from '../data/restaurant.json';
import NazarMark from './NazarMark.astro';

const { avisGoogle } = restaurant;
const enPlaceholder = avisGoogle.citations.every((c) => c.texte.includes('PLACEHOLDER'));
---

<section id="avis" class="relative bg-nazar py-20 md:py-30">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-end md:justify-between" data-slice>
      <div class="max-w-xl">
        <p class="mb-4 text-sm font-semibold tracking-[0.16em] text-ciel uppercase">Ce qu'on dit de nous</p>
        <h2 class="font-display text-3xl leading-tight font-700 text-creme md:text-4xl">
          {avisGoogle.note}/5 sur plus de {avisGoogle.nombreAvis} avis.
        </h2>
      </div>

      <!--
        L'oeil protecteur veille sur la reputation du lieu : il pulse UNE fois
        a l'entree dans le viewport, puis ne bouge plus. Pas une icone posee la.
      -->
      <NazarMark class="nazar-veille h-16 w-16 shrink-0 md:h-20 md:w-20" />
    </div>

    {enPlaceholder && (
      <p class="mt-8 rounded-lg border border-braise/50 bg-braise/10 px-4 py-3 text-sm text-braise" data-slice>
        <strong>PLACEHOLDER</strong> — avis en attente des vrais extraits de la fiche Google
        (TODO-CLIENT.md, point 5).
      </p>
    )}

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {avisGoogle.citations.map((avis) => (
        <li class="rounded-2xl bg-creme/8 p-6 ring-1 ring-creme/15" data-slice>
          <p class="text-braise" aria-label={`${avis.note} sur 5`}>{'★'.repeat(avis.note)}</p>
          <blockquote class="mt-3 text-creme/90">{avis.texte}</blockquote>
          <p class="mt-4 text-sm text-ciel">{avis.auteur}</p>
        </li>
      ))}
    </ul>

    <a
      href={avisGoogle.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-10 inline-flex min-h-12 items-center gap-2 text-creme underline decoration-ciel underline-offset-4 transition hover:text-ciel"
      data-slice
    >
      Lire les avis sur Google
    </a>
  </div>
</section>

<style>
  @keyframes veille {
    0%, 100% { transform: scale(1); }
    45% { transform: scale(1.09); }
  }

  .nazar-veille {
    animation: veille 1100ms var(--ease-lame) 1 both;
    animation-play-state: paused;
  }

  .nazar-veille.vu {
    animation-play-state: running;
  }

  @media (prefers-reduced-motion: reduce) {
    .nazar-veille { animation: none; }
  }
</style>

<script>
  const oeil = document.querySelector('.nazar-veille');
  if (oeil && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('vu');
            io.disconnect(); // une seule fois, jamais en boucle
          }
        }
      },
      { threshold: 0.5 }
    );
    io.observe(oeil);
  }
</script>
