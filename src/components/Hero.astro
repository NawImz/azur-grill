---
import { Picture } from 'astro:assets';
import restaurant from '../data/restaurant.json';
import Broche from './Broche.astro';
import painMaison from '../assets/photos-v2/about-pain-maison.webp';

// Six bandes : assez pour lire « tranches », assez peu pour rester net.
const bandes = [0, 1, 2, 3, 4, 5];
---

<section id="top" class="relative isolate flex min-h-[92svh] items-end overflow-hidden bg-nazar">
  <!--
    L'image est peinte des le depart, sous les bandes : la sequence ne
    retarde pas son chargement. fetchpriority=high + eager, c'est le LCP.
  -->
  <Picture
    src={painMaison}
    formats={['avif', 'webp']}
          fallbackFormat="webp"
    alt="Les pains d'Azur Grill, cuits sur place, alignés à la sortie du four sur la planche de bois."
    widths={[640, 960, 1360]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    style="object-position: 50% 34%;"
  />

  <!--
    Scrim asymetrique, pas un voile uniforme (CLAUDE.md §4.10) : dense en bas,
    ou le titre se pose ET ou la photo est encombree (sacs, cagettes) ;
    transparent au centre pour laisser les pains respirer. Opacites arretees
    par mesure du composite reel, pas au jugé — voir le rapport de QA.
  -->
  <div
    class="absolute inset-0 -z-10"
    style="background: linear-gradient(to top, rgb(10 6 60 / 0.95) 0%, rgb(10 6 60 / 0.90) 26%, rgb(10 6 60 / 0.66) 46%, rgb(10 6 60 / 0.22) 74%, rgb(10 6 60 / 0.34) 100%);"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-32 md:px-8 md:pb-24 md:pt-40">
    <p class="hero-ligne mb-5 flex items-center gap-2.5 text-sm font-semibold tracking-[0.16em] text-ciel uppercase" style="--r: 1">
      {restaurant.cuisine} · Épinay-sur-Seine
    </p>

    <h1
      class="hero-ligne max-w-[15ch] font-display text-4xl leading-[1.04] font-700 text-creme md:text-5xl"
      style="--r: 2"
    >
      {restaurant.promesse}
    </h1>

    <p class="hero-ligne mt-6 max-w-lg text-lg text-creme/90" style="--r: 3">
      {restaurant.promesseAppui}
    </p>

    <div class="hero-ligne mt-9 flex flex-wrap items-center gap-3" style="--r: 4">
      <a
        href={restaurant.uberEatsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center rounded-full bg-braise px-7 font-bold text-encre transition hover:brightness-110"
      >
        Commander
      </a>
      <a
        href="#carte"
        class="inline-flex min-h-12 items-center rounded-full border border-creme/40 px-7 font-semibold text-creme transition hover:border-creme hover:bg-creme/10"
      >
        Voir la carte
      </a>
    </div>
  </div>

  <!--
    Les bandes sont un rideau EN SURIMPRESSION, jamais un clip-path porte par
    une section observee : un clip annulerait la surface d'intersection et
    figerait tout observateur (CLAUDE.md §4.7).
  -->
  <div class="pointer-events-none absolute inset-0 z-20 flex" aria-hidden="true">
    {bandes.map((i) => <span class="lame-bande flex-1 bg-nazar motion-reduce:hidden" style={`--i: ${i}`} />)}
  </div>

  <Broche class="broche pointer-events-none absolute right-6 top-1/2 z-30 hidden h-32 -translate-y-1/2 text-ciel md:block motion-reduce:!hidden" />
</section>

<style>
  /* La tranche tombe : la bande s'ecrase vers sa base et sort du champ. */
  @keyframes lame-tombe {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0);
    }
  }

  @keyframes broche-tourne {
    0% {
      opacity: 0;
      transform: translateY(-50%) rotateY(0deg);
    }
    18% {
      opacity: 0.65;
    }
    72% {
      opacity: 0.65;
    }
    100% {
      opacity: 0;
      transform: translateY(-50%) rotateY(360deg);
    }
  }

  @keyframes ligne-monte {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lame-bande {
    transform-origin: bottom;
    /* 5 x 55 ms de decalage + 620 ms = 895 ms, sous le plafond de 900 ms. */
    animation: lame-tombe 620ms var(--ease-lame) forwards;
    animation-delay: calc(var(--i) * 55ms);
  }

  .broche {
    opacity: 0;
    animation: broche-tourne 900ms ease-in-out forwards;
  }

  .hero-ligne {
    opacity: 0;
    animation: ligne-monte 620ms var(--ease-lame) forwards;
    animation-delay: calc(360ms + var(--r) * 70ms);
  }

  /* Plancher d'accessibilite : etat final d'emblee, aucune sequence. */
  /* Plancher d'accessibilite : etat final d'emblee, aucune sequence.
     Les bandes et la broche sont neutralisees par `motion-reduce:` cote
     balise — une regle de composant ne battrait pas leurs utilities. */
  @media (prefers-reduced-motion: reduce) {
    .hero-ligne {
      opacity: 1;
      animation: none;
    }
  }
</style>
