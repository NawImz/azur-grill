---
import restaurant from '../data/restaurant.json';
---

<div class="fixed inset-x-0 bottom-0 z-30 flex gap-2 border-t border-creme/15 bg-nazar px-4 py-3 md:hidden">
  <a
    href={restaurant.telephoneLien}
    class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-braise font-bold text-encre"
  >
    Appeler
  </a>
  <a
    href={restaurant.googleMapsItineraire}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full border border-creme/40 font-semibold text-creme"
  >
    Itinéraire
  </a>
</div>
