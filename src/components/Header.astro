---
import restaurant from '../data/restaurant.json';
import NazarMark from './NazarMark.astro';
import Wordmark from './Wordmark.astro';

const navLinks = [
  { href: '#carte', label: 'La carte' },
  { href: '#avis', label: 'Avis' },
  { href: '#lieu', label: 'Le lieu' },
  { href: '#infos', label: 'Infos pratiques' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-40 bg-nazar/95 transition-transform duration-300"
  data-hidden="false"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:h-20 md:px-8">
    <a href="#top" class="flex min-h-11 items-center gap-2.5 text-creme" aria-label={`${restaurant.nom} — retour en haut`}>
      <NazarMark class="h-7 w-7 shrink-0" />
      <Wordmark taille="md" class="text-creme" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navigation principale">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-underline text-sm font-semibold text-creme transition-colors hover:text-ciel">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={restaurant.telephoneLien}
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full px-3 text-sm font-semibold text-creme transition-colors hover:text-ciel"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="hidden sm:inline">{restaurant.telephone}</span>
      </a>

      <!-- Bouton unique de l'en-tete : « Commander » (arbitrage valide). -->
      <a
        href={restaurant.uberEatsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden min-h-11 items-center rounded-full bg-braise px-5 text-sm font-bold text-encre transition hover:brightness-110 sm:inline-flex"
      >
        Commander
      </a>

      <button
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center text-creme lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!--
  Le panneau mobile est un FRERE du <header>, jamais un descendant.
  Un backdrop-filter sur une barre fixe en fait le containing block de ses
  descendants position:fixed : le panneau inset-0 serait alors ecrase a la
  hauteur de la barre (CLAUDE.md §4.5). Le sortir du header rend le bug
  impossible par construction plutot que de le rattraper au cas par cas.
-->
<nav
  id="mobile-nav"
  class="fixed inset-0 z-50 hidden flex-col bg-nazar px-6 pt-6 lg:hidden"
  aria-label="Navigation mobile"
>
  <div class="mb-8 flex items-center justify-between">
    <Wordmark taille="md" class="text-creme" />
    <button id="menu-close" class="flex h-11 w-11 items-center justify-center text-creme" aria-label="Fermer le menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {navLinks.map((link) => (
    <a href={link.href} class="border-b border-creme/15 py-4 font-display text-lg text-creme">
      {link.label}
    </a>
  ))}

  <a
    href={restaurant.telephoneLien}
    class="mt-8 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-braise px-5 py-3.5 font-bold text-encre"
  >
    Appeler le {restaurant.telephone}
  </a>
</nav>

<style>
  .nav-underline {
    position: relative;
  }

  .nav-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease-out;
  }

  .nav-underline:hover::after,
  .nav-underline:focus-visible::after {
    transform: scaleX(1);
  }

  #site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition: none;
    }
    #site-header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const nav = document.getElementById('mobile-nav');

  let open = false;
  const setOpen = (next: boolean) => {
    open = next;
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('hidden', !open);
    nav?.classList.toggle('flex', open);
    document.body.classList.toggle('overflow-hidden', open);
    if (open) close?.focus();
    else toggle?.focus();
  };

  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });

  // La barre s'efface en descente passe le hero, revient a la moindre remontee.
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      if (!header) return;
      const y = window.scrollY;
      header.dataset.hidden = y > 280 && y > lastY && !open ? 'true' : 'false';
      lastY = y;
    },
    { passive: true }
  );
</script>
