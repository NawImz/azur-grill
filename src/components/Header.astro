---
import restaurant from '../data/restaurant.json';
import NazarMark from './NazarMark.astro';
import Wordmark from './Wordmark.astro';
import { lien } from '../lib/url';

// Les ancres sont prefixees par l'accueil : sur la page d'accueil le
// navigateur reconnait la meme page et se contente de defiler, depuis la
// carte il revient a l'accueil a la bonne section. Une ancre nue, elle,
// n'aurait rien fait depuis /carte.
const navLinks = [
  { href: lien('#carte'), label: 'La carte' },
  { href: lien('#avis'), label: 'Avis' },
  { href: lien('#lieu'), label: 'Le lieu' },
  { href: lien('#infos'), label: 'Infos pratiques' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-60 bg-nazar/95 transition-transform duration-300"
  data-hidden="false"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:h-20 md:px-8">
    <a href={lien("#top")} class="flex min-h-11 items-center gap-2.5 text-creme" aria-label={`${restaurant.nom} — retour en haut`}>
      <NazarMark class="h-7 w-7 shrink-0" />
      <Wordmark taille="md" class="text-creme" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navigation principale">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-underline text-sm font-semibold text-creme transition-colors hover:text-ciel">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={restaurant.telephoneLien}
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full px-3 text-sm font-semibold text-creme transition-colors hover:text-ciel"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="hidden sm:inline">{restaurant.telephone}</span>
      </a>

      <!-- Bouton unique de l'en-tete : « Commander » (arbitrage valide). -->
      <a
        href={restaurant.uberEatsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden min-h-11 items-center rounded-full bg-braise px-5 text-sm font-bold text-encre transition hover:brightness-110 sm:inline-flex"
      >
        Commander
      </a>

      <!--
        Un seul bouton pour ouvrir ET fermer : les trois barres se replient
        en croix. Deux boutons distincts obligeaient l'oeil a retrouver la
        fermeture ailleurs ; ici le meme point reste sous le pouce.
      -->
      <button
        id="menu-toggle"
        class="burger relative flex h-11 w-11 items-center justify-center lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="barre barre-1"></span>
        <span class="barre barre-2"></span>
        <span class="barre barre-3"></span>
      </button>
    </div>
  </div>
</header>

<!--
  Le panneau mobile est un FRERE du <header>, jamais un descendant.
  Un backdrop-filter sur une barre fixe en fait le containing block de ses
  descendants position:fixed : le panneau inset-0 serait alors ecrase a la
  hauteur de la barre (CLAUDE.md §4.5). Le sortir du header rend le bug
  impossible par construction plutot que de le rattraper au cas par cas.
-->
<div id="menu-voile" class="fixed inset-0 z-40 bg-encre/60 opacity-0 lg:hidden" aria-hidden="true"></div>

<nav
  id="mobile-nav"
  class="fixed inset-y-0 right-0 z-50 flex w-[86%] max-w-sm flex-col bg-nazar px-6 pb-8 pt-24 lg:hidden"
  aria-label="Navigation mobile"
  aria-hidden="true"
>
  {navLinks.map((link, i) => (
    <a
      href={link.href}
      class="lien-menu border-b border-creme/15 py-4 font-display text-lg text-creme"
      style={`--n:${i}`}
    >
      {link.label}
    </a>
  ))}

  <a
    href={restaurant.telephoneLien}
    class="lien-menu mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-braise px-5 font-bold text-encre"
    style={`--n:${navLinks.length}`}
  >
    Appeler le {restaurant.telephone}
  </a>

  <p class="lien-menu mt-auto pt-8 text-sm text-creme/60" style={`--n:${navLinks.length + 1}`}>
    {restaurant.adresse.texte}
  </p>
</nav>

<style>
  .nav-underline {
    position: relative;
  }

  .nav-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease-out;
  }

  .nav-underline:hover::after,
  .nav-underline:focus-visible::after {
    transform: scaleX(1);
  }

  #site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  /*
    Les trois barres du burger se replient en croix. Chacune est un vrai
    element : une icone SVG echangee d'un coup ne peut pas se deformer, elle
    ne peut que disparaitre et reapparaitre — c'est exactement l'effet
    « ca saute » qu'on cherche a supprimer.

    Les barres du haut et du bas se rejoignent au centre avant de pivoter,
    en deux temps (translate d'abord, rotation ensuite) : replier puis
    croiser se lit comme un geste, un mouvement simultane comme un glitch.
  */
  .barre {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2px;
    margin-left: -11px;
    border-radius: 2px;
    background: var(--color-creme);
    transition:
      transform 0.42s var(--ease-lame),
      opacity 0.2s ease;
  }

  .barre-1 { transform: translateY(-7px); }
  .barre-2 { transform: translateY(0); }
  .barre-3 { transform: translateY(7px); }

  /* La barre du milieu s'efface d'abord, les autres pivotent ensuite. */
  .burger[aria-expanded='true'] .barre-1 {
    transform: translateY(0) rotate(45deg);
    transition-delay: 0.06s;
  }

  .burger[aria-expanded='true'] .barre-2 {
    opacity: 0;
    transform: scaleX(0.2);
  }

  .burger[aria-expanded='true'] .barre-3 {
    transform: translateY(0) rotate(-45deg);
    transition-delay: 0.06s;
  }

  /* Le panneau glisse depuis le bord droit, d'ou vient le pouce. */
  #mobile-nav {
    transform: translateX(100%);
    visibility: hidden;
    box-shadow: -24px 0 60px -20px rgb(0 0 0 / 0.5);
    transition:
      transform 0.46s var(--ease-pose),
      visibility 0s linear 0.46s;
  }

  #mobile-nav[data-ouvert='true'] {
    transform: none;
    visibility: visible;
    transition:
      transform 0.46s var(--ease-pose),
      visibility 0s;
  }

  #menu-voile {
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0s linear 0.4s;
  }

  #menu-voile[data-ouvert='true'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.4s ease,
      visibility 0s;
  }

  /* Les entrees arrivent en cascade derriere le panneau, pas avec lui. */
  .lien-menu {
    opacity: 0;
    transform: translateX(18px);
    transition:
      opacity 0.4s var(--ease-pose),
      transform 0.4s var(--ease-pose);
  }

  #mobile-nav[data-ouvert='true'] .lien-menu {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.16s + var(--n) * 0.055s);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition: none;
    }
    #site-header[data-hidden='true'] {
      transform: none;
    }
    .barre,
    #mobile-nav,
    #menu-voile,
    .lien-menu {
      transition: none;
    }
    .lien-menu {
      opacity: 1;
      transform: none;
    }
  }

</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const voile = document.getElementById('menu-voile');

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;
    // Un seul attribut pilote tout : le bouton porte l'etat, le CSS s'y
    // accroche. Pas de bascule de `hidden`, qui coupe toute transition.
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    nav?.setAttribute('data-ouvert', String(open));
    nav?.setAttribute('aria-hidden', String(!open));
    voile?.setAttribute('data-ouvert', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  };

  toggle?.addEventListener('click', () => setOpen(!open));
  voile?.addEventListener('click', () => setOpen(false));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });

  // Le panneau reste hors du parcours clavier tant qu'il est ferme : sans
  // cela, la tabulation entre dans un menu invisible, hors ecran.
  const focusables = () => nav?.querySelectorAll<HTMLElement>('a[href]') ?? [];
  const majTabIndex = () => focusables().forEach((el) => (el.tabIndex = open ? 0 : -1));
  majTabIndex();
  toggle?.addEventListener('click', majTabIndex);
  voile?.addEventListener('click', majTabIndex);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') majTabIndex();
  });


  // La barre s'efface en descente passe le hero, revient a la moindre remontee.
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      if (!header) return;
      const y = window.scrollY;
      header.dataset.hidden = y > 280 && y > lastY && !open ? 'true' : 'false';
      lastY = y;
    },
    { passive: true }
  );
</script>
