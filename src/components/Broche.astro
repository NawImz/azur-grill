---
/**
 * Silhouette de broche au trait, dans la logique geometrique du logo
 * (cercles concentriques, trait unique, aucun degrade). Elle ne tourne
 * qu'une fois, pendant la sequence de tranches, puis disparait.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 80 160" fill="none" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <!-- axe vertical de la broche -->
  <path d="M40 6v148" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  <!-- masse de viande empilee : trois galbes de largeur decroissante -->
  <path d="M40 26c14 0 23 9 23 20s-9 19-23 19-23-8-23-19 9-20 23-20Z" stroke="currentColor" stroke-width="2.5" />
  <path d="M40 65c12 0 20 8 20 18s-8 17-20 17-20-7-20-17 8-18 20-18Z" stroke="currentColor" stroke-width="2.5" />
  <path d="M40 100c9 0 16 7 16 14s-7 13-16 13-16-6-16-13 7-14 16-14Z" stroke="currentColor" stroke-width="2.5" />
  <!-- la lame, a droite, a hauteur de coupe -->
  <path d="M64 78h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
</svg>
