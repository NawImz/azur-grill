<script>
  /*
    Revelation d'entree de section : la meme lame que le hero, en plus discret.

    Principe : ScrollTrigger ne fait que DETECTER, il n'anime rien. Il pose
    une classe, et c'est le CSS qui joue la transition.

    C'est le point cle. Tant que GSAP pilotait lui-meme l'opacite et le
    clip-path, il pouvait aussi les defaire : au moindre recalcul de ses
    reperes — et il y en a apres chaque image decodee — un element deja
    revele repartait a zero. Mesure sur la version precedente : onze
    rechutes en remontant la page, dont un bloc d'horaires retombe a 0,11
    d'opacite avec un clip a mi-course. Une classe, elle, ne se defait pas
    toute seule.

    Note sur le piege du clip-path (CLAUDE.md §4.7) : il vise
    l'IntersectionObserver, dont la surface d'intersection est annulee par
    le clip. ScrollTrigger travaille sur les positions geometriques, que le
    clip ne modifie pas — declencher sur l'element lui-meme est donc sur.
  */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cibles = document.querySelectorAll<HTMLElement>('[data-slice]');

  const montrer = (el: HTMLElement) => el.classList.add('shown');

  if (reduit || !cibles.length) {
    cibles.forEach(montrer);
  } else {
    let gsap, ScrollTrigger;
    try {
      ({ gsap } = await import('gsap'));
      ({ ScrollTrigger } = await import('gsap/ScrollTrigger'));
      gsap.registerPlugin(ScrollTrigger);
    } catch {
      // L'etat cache vient du CSS : sans GSAP, la page resterait vide sous
      // le hero. On revele tout plutot que de ne rien montrer.
      cibles.forEach(montrer);
      throw new Error('revelations desactivees : GSAP indisponible');
    }

    /*
      Decalage au sein d'une meme rangee.

      La carte etale ses plats sur six rangees de deux : l'animation s'y
      deroule en vagues successives, que l'oeil suit. Les avis et le lieu
      alignent quatre elements a la meme hauteur — sans decalage, toute la
      largeur de l'ecran bouge d'un bloc, et il n'y a plus rien a suivre :
      c'est fini avant qu'on ait regarde. D'ou l'impression que ces
      sections s'animent trop tot alors que la carte tombe juste.

      On regroupe donc par hauteur, et chaque element part legerement apres
      son voisin de gauche. La carte ne bouge presque pas (deux par rangee),
      les rangees de quatre se remplissent maintenant de gauche a droite.
    */
    const rangees = new Map<number, HTMLElement[]>();
    cibles.forEach((el) => {
      const haut = Math.round((el.getBoundingClientRect().top + window.scrollY) / 30);
      if (!rangees.has(haut)) rangees.set(haut, []);
      rangees.get(haut)!.push(el);
    });

    rangees.forEach((elements) => {
      if (elements.length < 2) return;
      elements
        .sort((a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left)
        .forEach((el, i) => el.style.setProperty('--retard', `${i * 0.11}s`));
    });

    cibles.forEach((el) => {
      ScrollTrigger.create({
        trigger: el,
        // Sixieme reglage, chacun mesure : 88, 78, 66, 55, 45, puis 40 %.
        // On s'arrete la : plus bas, l'element serait deja bien lisible
        // avant de bouger et l'animation paraitrait en retard sur le
        // regard, au lieu d'accompagner son arrivee.
        start: 'top 40%',
        once: true,
        onEnter: () => montrer(el),
      });
    });

    /*
      Recalcul des reperes une fois les images chargees : elles allongent la
      page et decalent tout ce qui suit. Sans danger desormais — un refresh
      ne peut plus defaire une classe deja posee.
    */
    const rafraichir = () => ScrollTrigger.refresh();
    if (document.readyState === 'complete') rafraichir();
    else window.addEventListener('load', rafraichir, { once: true });

    Promise.all(
      Array.from(document.images)
        .filter((img) => !img.complete)
        .map((img) => img.decode().catch(() => undefined))
    ).then(rafraichir);

    // Filet : ne revele que ce qui est reellement dans le champ, et ne
    // s'arme en continu qu'apres une defaillance constatee.
    let defaillance = false;
    const filet = () => {
      cibles.forEach((el) => {
        if (el.classList.contains('shown')) return;
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) {
          defaillance = true;
          montrer(el);
        }
      });
    };
    setTimeout(() => {
      filet();
      if (defaillance) {
        window.addEventListener('scroll', () => requestAnimationFrame(filet), { passive: true });
      }
    }, 4000);
  }
</script>
