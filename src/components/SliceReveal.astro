<script>
  /*
    Revelation d'entree de section : la meme lame que le hero, en plus discret.

    Principe : ScrollTrigger ne fait que DETECTER, il n'anime rien. Il pose
    une classe, et c'est le CSS qui joue la transition.

    C'est le point cle. Tant que GSAP pilotait lui-meme l'opacite et le
    clip-path, il pouvait aussi les defaire : au moindre recalcul de ses
    reperes — et il y en a apres chaque image decodee — un element deja
    revele repartait a zero. Mesure sur la version precedente : onze
    rechutes en remontant la page, dont un bloc d'horaires retombe a 0,11
    d'opacite avec un clip a mi-course. Une classe, elle, ne se defait pas
    toute seule.

    Note sur le piege du clip-path (CLAUDE.md §4.7) : il vise
    l'IntersectionObserver, dont la surface d'intersection est annulee par
    le clip. ScrollTrigger travaille sur les positions geometriques, que le
    clip ne modifie pas — declencher sur l'element lui-meme est donc sur.
  */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cibles = document.querySelectorAll<HTMLElement>('[data-slice]');

  const montrer = (el: HTMLElement) => el.classList.add('shown');

  if (reduit || !cibles.length) {
    cibles.forEach(montrer);
  } else {
    let gsap, ScrollTrigger;
    try {
      ({ gsap } = await import('gsap'));
      ({ ScrollTrigger } = await import('gsap/ScrollTrigger'));
      gsap.registerPlugin(ScrollTrigger);
    } catch {
      // L'etat cache vient du CSS : sans GSAP, la page resterait vide sous
      // le hero. On revele tout plutot que de ne rien montrer.
      cibles.forEach(montrer);
      throw new Error('revelations desactivees : GSAP indisponible');
    }

    /*
      Decalage au sein d'une meme rangee.

      La carte etale ses plats sur six rangees de deux : l'animation s'y
      deroule en vagues successives, que l'oeil suit. Les avis et le lieu
      alignent quatre elements a la meme hauteur — sans decalage, toute la
      largeur de l'ecran bouge d'un bloc, et il n'y a plus rien a suivre :
      c'est fini avant qu'on ait regarde. D'ou l'impression que ces
      sections s'animent trop tot alors que la carte tombe juste.

      On regroupe donc par hauteur, et chaque element part legerement apres
      son voisin de gauche. La carte ne bouge presque pas (deux par rangee),
      les rangees de quatre se remplissent maintenant de gauche a droite.
    */
    const rangees = new Map<number, HTMLElement[]>();
    cibles.forEach((el) => {
      const haut = Math.round((el.getBoundingClientRect().top + window.scrollY) / 30);
      if (!rangees.has(haut)) rangees.set(haut, []);
      rangees.get(haut)!.push(el);
    });

    rangees.forEach((elements) => {
      if (elements.length < 2) return;
      elements
        .sort((a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left)
        .forEach((el, i) => el.style.setProperty('--retard', `${i * 0.15}s`));
    });

    cibles.forEach((el) => {
      ScrollTrigger.create({
        trigger: el,
        // La ligne est posee a 75 % de la fenetre : un element commence a
        // apparaitre peu apres etre entre par le bas.
        //
        // Les reglages precedents (88, 78, 66, 55, 45, 40, 34 %) ne
        // regardaient que l'element de TETE d'une rangee. La mesure a
        // montre le vrai defaut : avec la cascade de 150 ms, les elements
        // suivants demarraient a 5 %, -22 %, -46 % — deja sortis par le
        // haut. A 75 %, la rangee entiere se joue dans le champ.
        start: 'top 75%',
        once: true,
        onEnter: () => montrer(el),
      });
    });

    /*
      Filet pour le pied de page, et pour lui seul.

      Un element proche du bas ne peut pas toujours monter jusqu'au seuil :
      il n'y a plus assez de page a faire defiler. Constate sur le bloc
      « Horaires », qui plafonnait a 40 % de la fenetre pour un seuil fixe
      a 34 %, et restait donc invisible.

      On ne pose ce filet que sur les elements concernes, calcules : un
      filet applique a tous declencherait des qu'ils entrent par le bas et
      annulerait tout le retard recherche — mesure, la moyenne remontait
      de 25 % a 66 %.
    */
    const poserFiletsDuBas = () => {
      const maxDefilement = document.documentElement.scrollHeight - window.innerHeight;
      const seuil = window.innerHeight * 0.75;
      cibles.forEach((el) => {
        if (el.classList.contains('shown') || el.dataset.filet === 'pose') return;
        const hautAbsolu = el.getBoundingClientRect().top + window.scrollY;
        // ou se trouvera son haut quand la page sera defilee au maximum
        if (hautAbsolu - maxDefilement > seuil) {
          el.dataset.filet = 'pose';
          ScrollTrigger.create({
            trigger: el,
            start: 'bottom bottom',
            once: true,
            onEnter: () => montrer(el),
          });
        }
      });
    };

    /*
      Recalcul des reperes une fois les images chargees : elles allongent la
      page et decalent tout ce qui suit. Sans danger desormais — un refresh
      ne peut plus defaire une classe deja posee.
    */
    const rafraichir = () => {
      ScrollTrigger.refresh();
      poserFiletsDuBas();
    };
    poserFiletsDuBas();
    if (document.readyState === 'complete') rafraichir();
    else window.addEventListener('load', rafraichir, { once: true });

    Promise.all(
      Array.from(document.images)
        .filter((img) => !img.complete)
        .map((img) => img.decode().catch(() => undefined))
    ).then(rafraichir);

    /*
      Filet declenche a l'ARRET du defilement.

      Un element peut etre entierement a l'ecran sans avoir atteint le
      seuil de lecture : c'est le cas en bas de page, ou il ne reste plus
      assez a faire defiler. Constate sur le bloc « Horaires », visible au
      tiers de l'ecran et pourtant vide.

      La condition d'immobilite est ce qui rend ce filet inoffensif :
      pendant un defilement continu il ne fait rien, donc il ne raccourcit
      jamais le retard voulu. Il n'agit que si le lecteur s'arrete devant
      un bloc encore vide — le seul cas ou l'attente devient genante.
    */
    let minuteur: number | undefined;
    const remplirLesVides = () => {
      const vh = window.innerHeight;
      cibles.forEach((el) => {
        if (el.classList.contains('shown')) return;
        const r = el.getBoundingClientRect();
        const visible = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
        // « Entierement visible » ne suffit pas : un bloc plus haut que la
        // fenetre, ou a cheval sur un bord, ne l'est jamais et resterait
        // vide. On regarde donc ce que le lecteur voit reellement — une
        // bonne part de l'element, ou une bonne part de son ecran.
        if (visible >= r.height * 0.5 || visible >= vh * 0.4) montrer(el);
      });
    };

    const armer = () => {
      window.clearTimeout(minuteur);
      minuteur = window.setTimeout(remplirLesVides, 600);
    };

    window.addEventListener('scroll', armer, { passive: true });
    armer();
  }
</script>
