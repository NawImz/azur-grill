<script>
  /*
    Revelation d'entree : la meme lame que le hero, en plus discret.

    Chaque element a SON propre declencheur, calcule sur SA position. Une
    version precedente animait d'un coup tous les enfants d'une section :
    les premiers etaient bien places, mais les derniers se trouvaient a 140 %
    du viewport — encore sous l'ecran. Leur animation etait donc terminee
    avant que le lecteur arrive dessus, et il ne voyait jamais que le
    resultat. C'est le defaut que ce decoupage corrige.

    Note sur le piege du clip-path (CLAUDE.md §4.7) : il vise
    l'IntersectionObserver, qui calcule une surface d'intersection annulee
    par le clip. ScrollTrigger travaille sur les positions geometriques, que
    le clip ne modifie pas — declencher sur l'element lui-meme est donc sur
    ici, et c'est verifie par la mesure de position au declenchement.
  */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cibles = document.querySelectorAll<HTMLElement>('[data-slice]');

  // La classe `shown` est le signal auquel s'accrochent les animations CSS
  // derivees (le trait de la carte, le filet des intitules, les etoiles).
  const montrer = (el: HTMLElement) => {
    el.style.opacity = '1';
    el.style.clipPath = 'inset(0 0 0 0)';
    el.classList.add('shown');
  };

  if (reduit || !cibles.length) {
    cibles.forEach(montrer);
  } else {
    cibles.forEach((el) => {
      el.style.opacity = '0';
      el.style.clipPath = 'inset(0 0 100% 0)';
      el.style.willChange = 'opacity, clip-path';
    });

    const { gsap } = await import('gsap');
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    cibles.forEach((el) => {
      gsap.to(el, {
        opacity: 1,
        clipPath: 'inset(0 0 0% 0)',
        duration: 0.85,
        ease: 'power2.out',
        clearProps: 'willChange',
        onStart: () => el.classList.add('shown'),
        scrollTrigger: {
          trigger: el,
          // L'element entre par le bas : l'animation se joue pendant qu'il
          // monte vers le regard, au lieu de s'achever hors champ.
          start: 'top 88%',
          once: true,
        },
      });
    });

    /*
      Recalcul des reperes une fois les images chargees. ScrollTrigger fige
      les positions a l'initialisation ; les images arrivant ensuite
      allongent la page et decalent tout ce qui suit. Sans ce refresh, les
      elements du bas se declenchaient a plus de 150 % du viewport —
      c'est-a-dire largement sous l'ecran, donc sans spectateur.
    */
    const rafraichir = () => ScrollTrigger.refresh();
    if (document.readyState === 'complete') rafraichir();
    else window.addEventListener('load', rafraichir, { once: true });

    // Les images d'Astro se decodent apres le load : on repasse une fois.
    Promise.all(
      Array.from(document.images)
        .filter((img) => !img.complete)
        .map((img) => img.decode().catch(() => undefined))
    ).then(rafraichir);

    /*
      Filet de securite, si ScrollTrigger venait a ne pas prendre la main.
      Il ne revele QUE ce qui est effectivement dans le champ : une version
      precedente revelait tout le document apres 4 s, si bien qu'un lecteur
      qui descendait lentement trouvait le bas de page deja decouvert, sans
      animation. Et il ne s'arme en continu qu'apres avoir constate une
      defaillance reelle — sinon il ne coute qu'un seul passage.
    */
    const dansLeChamp = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    };

    let defaillance = false;

    const filet = () => {
      cibles.forEach((el) => {
        if (el.classList.contains('shown') || !dansLeChamp(el)) return;
        defaillance = true;
        montrer(el);
      });
    };

    setTimeout(() => {
      filet();
      if (defaillance) {
        window.addEventListener('scroll', () => requestAnimationFrame(filet), { passive: true });
      }
    }, 4000);
  }
</script>
