---
import restaurant from '../data/restaurant.json';
import NazarMark from './NazarMark.astro';
import Wordmark from './Wordmark.astro';
const annee = new Date().getFullYear();
---

<footer class="border-t border-creme/15 bg-nazar py-12">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex items-center gap-2.5">
          <NazarMark class="h-7 w-7" />
          <Wordmark taille="md" class="text-creme" />
        </div>
        <p class="mt-3 text-sm text-creme/70">{restaurant.adresse.texte}</p>
        <a href={restaurant.telephoneLien} class="mt-1 inline-flex min-h-11 items-center text-sm text-creme/70 hover:text-ciel">
          {restaurant.telephone}
        </a>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <a href={restaurant.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-creme/70 hover:text-ciel">
          Instagram
        </a>
        <a href="/carte" class="inline-flex min-h-11 items-center text-creme/70 hover:text-ciel">La carte complète</a>
        <span class="inline-flex min-h-11 items-center text-braise">Mentions légales — à fournir (TODO-CLIENT.md, point 9)</span>
      </div>
    </div>

    <p class="mt-10 text-xs text-creme/45">© {annee} {restaurant.nomComplet} · Tous droits réservés.</p>
  </div>
</footer>
